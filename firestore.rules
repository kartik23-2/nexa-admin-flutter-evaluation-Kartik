rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() 
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.status in ['Active', 'Inactive'];
      allow delete: if isAuthenticated();
    }

    // Branches & Geofence collection
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.data.name is string
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.radius is number;
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.employeeId is string
        && request.resource.data.branchId is string
        && request.resource.data.status in ['Present', 'Absent', 'Rejected'];
      allow update, delete: if isAuthenticated();
    }

    // Customers / Leads
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.data.name is string
        && request.resource.data.status in ['New', 'Contacted', 'Interested', 'Converted', 'Rejected', 'Lead', 'Qualified', 'Closed - Won', 'Closed - Lost'];
    }

    // Documents (ID proofs, verification records)
    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.fileUrl is string;
      allow update, delete: if isAuthenticated();
    }

    // Expenses & Approvals
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.amount is number
        && request.resource.data.status in ['Pending', 'Approved', 'Rejected'];
      allow update: if isAuthenticated()
        && (
          !(request.resource.data.status == 'Rejected' && (!('rejectionReason' in request.resource.data) || request.resource.data.rejectionReason == ''))
        );
      allow delete: if isAuthenticated();
    }

    // Centralized Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.action is string
        && request.resource.data.adminId is string;
      allow update, delete: if false; // Audit logs are immutable append-only
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
