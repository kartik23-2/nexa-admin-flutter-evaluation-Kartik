rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPDF() {
      return request.resource.contentType == 'application/pdf';
    }

    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile photos
    match /profile_photos/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isValidSize();
    }

    // Customer & Employee documents (e.g. ID proofs)
    match /documents/{docId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isImage() || isPDF()) && isValidSize();
    }

    // Expense receipts
    match /receipts/{expenseId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isImage() || isPDF()) && isValidSize();
    }
  }
}
